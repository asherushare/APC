datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  COORDINATOR
  STAFF
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DOCUMENTS_PENDING
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum DocumentType {
  AADHAAR
  PAN
  PHOTOGRAPH
  PRODUCER_PROOF
  BANK_PASSBOOK
}

enum UploadStatus {
  UPLOADING
  DONE
  ERROR
}

enum VirusScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
}

model User {
  id           String                  @id @default(uuid())
  email        String                  @unique
  passwordHash String
  fullName     String
  role         Role                    @default(COORDINATOR)
  block        String?                 // Assigned geographical block
  applications ShareholderApplication[] // Applications reviewed
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  deletedAt    DateTime?               // Soft-delete support
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique // SHA-256 hash of refresh token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ShareholderApplication {
  id                     String            @id @default(uuid())
  applicationId          String            @unique // e.g. APC-2026-XXXXXX
  
  // Step 1: Personal Details
  fullName               String
  fatherHusbandName      String
  dateOfBirth            DateTime
  gender                 String
  aadhaarHash            String            @unique // SHA-256 of Aadhaar for uniqueness check
  aadhaarEncrypted       String            // Encrypted Aadhaar string for viewing
  aadhaarMasked          String            // e.g. XXXX-XXXX-1234
  panEncrypted           String?
  panMasked              String?
  mobileNumber           String
  email                  String?
  occupation             String
  
  // Step 2: Address
  village                String
  gramPanchayat          String
  block                  String
  district               String
  state                  String
  pinCode                String

  // Step 3: Producer Eligibility
  producerActivities     ProducerActivity[]

  // Step 4: Share Subscription
  numberOfShares         Int
  calculatedContribution Decimal           @db.Decimal(10, 2)

  // Step 5: Nominee Details
  nomineeName            String
  nomineeRelationship    String
  nomineeDateOfBirth     DateTime
  nomineeAddress         String
  nomineeMobileNumber    String

  // Step 6: Bank Details
  bankAccountHolderName  String
  bankName               String
  bankAccountNumberEnc   String            // Encrypted Bank Account Number
  bankAccountNumberMask  String            // e.g. XXXXXX1234
  bankIfscCode           String

  // Status & Flags
  status                 ApplicationStatus @default(SUBMITTED)
  paymentStatus          PaymentStatus     @default(PENDING)
  verificationStatus     VerificationStatus @default(PENDING)
  submittedAt            DateTime          @default(now())
  
  coordinatorId          String?
  reviewer               User?             @relation(fields: [coordinatorId], references: [id])
  reviewNotes            String?
  reviewedAt             DateTime?

  documents              Document[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?         // Soft-delete support
}

model Document {
  id              String                 @id @default(uuid())
  applicationId   String
  application     ShareholderApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType    DocumentType
  filename        String
  fileSize        Int
  mimeType        String
  storageKey      String                 // S3 Object path
  uploadStatus    UploadStatus           @default(UPLOADING)
  checksum        String?                // SHA-256 checksum of payload
  uploadedBy      String                 // UUID or applicant identifier
  verifiedBy      String?                // UUID of user verifying
  verifiedAt      DateTime?
  virusScanStatus VirusScanStatus        @default(PENDING)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?              // Soft-delete support
}

model ProducerActivity {
  id            String                 @id @default(uuid())
  applicationId String
  application   ShareholderApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  activityName  String
}

model AuditLog {
  id           String    @id @default(uuid())
  userId       String?   // User that triggered event
  user         User?     @relation(fields: [userId], references: [id])
  action       String    // e.g. STATUS_UPDATED, LOGIN_SUCCESS
  targetEntity String    // e.g. ShareholderApplication
  targetId     String    // UUID target reference
  changes      Json?     // Before/after snapshot
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
}
